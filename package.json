{
  "name": "wcies",
  "version": "0.1.0",
  "private": true,
  "description": "WCIES - Cross-border E-commerce Integrated Management System",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm --filter @wcies/shared --filter @wcies/platform-contracts --filter @wcies/api-client run build",
    "dev": "pnpm build:packages && pnpm --filter @wcies/api --filter @wcies/web --parallel run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @wcies/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @wcies/api dev",
    "dev:worker": "pnpm --filter @wcies/api dev:worker",
    "build": "pnpm build:packages && pnpm -r --if-present run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "check:arch": "tsx scripts/check-architecture.ts",
    "db:migrate": "tsx scripts/db.ts run",
    "db:rollback": "tsx scripts/db.ts revert",
    "db:migration:show": "tsx scripts/db.ts show",
    "db:migration:create": "tsx scripts/db.ts create",
    "db:migration:generate": "tsx scripts/db.ts generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed:dev": "pnpm --filter @wcies/api seed:dev",
    "openapi:export": "pnpm --filter @wcies/api openapi:export",
    "api-client:generate": "tsx scripts/generate-api-client.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "openapi-typescript": "^7.0.0",
    "pg": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typeorm": "^0.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
