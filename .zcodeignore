# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-docker/
build/
*.tsbuildinfo

# Environment - never commit real secrets
.env
.env.local
.env.*.local
.env.production
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Misc
tmp/
.cache/
.playwright-mcp/

# Agent session tooling artifacts (plans, throwaway scripts) - not project code
.zcode/
gui-*-screenshots/

# CodeGraph local index (AI tooling, machine-local)
.codegraph/

# DB backups (local only, never commit)
backups/

# Cloudflare Tunnel credentials (local only, never commit)
docker/cloudflared/credentials.json

